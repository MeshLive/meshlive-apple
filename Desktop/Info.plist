<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>MeshLiveSourceCommit</key>
	<string>$(MESHLIVE_SOURCE_COMMIT)</string>
	<key>MeshLiveDistribution</key>
	<string>$(MESHLIVE_DISTRIBUTION)</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Find people nearby and connect to them directly over Bluetooth for calls and live video, without the internet.</string>
	<key>NSCameraUsageDescription</key>
	<string>Send your video in video calls, and scan a contact's verification code.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Talk in voice and video calls.</string>
	<key>NSLocationUsageDescription</key>
	<string>Find the other phone's Wi-Fi Direct network during a call. MeshLive never reads your location.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Find the other phone's Wi-Fi Direct network during a call. MeshLive never reads your location.</string>
	<key>CFBundleName</key>
	<string>MeshLive</string>
	<key>CFBundleDisplayName</key>
	<string>MeshLive</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
</dict>
</plist>
